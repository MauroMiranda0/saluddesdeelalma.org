# backend/.env.production.template
#
# Plantilla final de produccion del backend (Express 5 + Prisma 6).
# Copiar a backend/.env.production en el servidor y reemplazar los valores
# marcados [RELLENAR MANUALMENTE]. El archivo resultante NO se commitea.
#
# El backend carga .env.production automaticamente cuando NODE_ENV=production
# (backend/src/config/load-env-file.ts). Prisma CLI NO lee este archivo.
#
# Validar SIEMPRE antes de arrancar:
#   npm run env:check:production --workspace backend
#
# En produccion, backend/src/config/env.ts rechaza placeholders, exige
# SESSION_IDLE_TIMEOUT_MINUTES=30 y exige ambos workers en true.

# --- Aplicacion (valores fijos) ---
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
# Origenes permitidos por CORS, separados por coma.
FRONTEND_ORIGIN=https://saluddesdeelalma.org,https://www.saluddesdeelalma.org
LOG_LEVEL=info

# --- Base de datos (Supabase) ---
# [RELLENAR MANUALMENTE] Cadena Transaction pooler (puerto 6543):
# postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true
# Reglas de validacion:
#   - Host *.pooler.supabase.com y puerto 6543.
#   - Terminar en ?pgbouncer=true.
#   - Codificar la contrasena si contiene @ : / ? # % (ej. @ -> %40).
# Las migraciones usan el Session pooler 5432 como override temporal;
# esa cadena no se guarda aqui. Ver DATABASE_BOOTSTRAP.md.
DATABASE_URL=replace-with-supabase-transaction-pooler-url

# --- Sesion admin ---
# [RELLENAR MANUALMENTE] Generar con: openssl rand -base64 48
# Reglas de validacion: minimo 32 caracteres y sin placeholders.
# Este placeholder es invalido a proposito: el arranque falla hasta reemplazarlo.
JWT_SECRET=replace-with-openssl-rand-base64-48
SESSION_COOKIE_NAME=sda_admin_session
# Debe ser exactamente 30; otro valor aborta el arranque en produccion.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Requerida por scripts/validate-production-env.mjs y DEPLOY_PLAN.md.
# El codigo actual emite la cookie sin domain (session.service.ts), pero no
# eliminar esta variable: el validador de produccion la exige.
COOKIE_DOMAIN=.saluddesdeelalma.org

# --- WhatsApp Cloud API (Meta) ---
# [RELLENAR MANUALMENTE] Token definido al configurar el webhook en Meta.
# Debe coincidir con el "Verify token" del panel de Meta.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
# [RELLENAR MANUALMENTE] Access Token de Meta (System User o temporal).
WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-access-token
# [RELLENAR MANUALMENTE] Phone Number ID numerico (solo digitos).
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-whatsapp-phone-number-id
# [RELLENAR MANUALMENTE] Numero individual de Jocelyn, formato internacional
# y solo digitos (sin +, espacios ni guiones).
WHATSAPP_ADMIN_PHONE=replace-with-jocelyn-whatsapp-phone
# [RELLENAR MANUALMENTE] Destino del grupo interno de psicologas.
# Verificar compatibilidad de grupos con la version actual de Meta.
WHATSAPP_PSYCHOLOGISTS_GROUP_ID=replace-with-psychologists-group-id

# --- Recordatorios ---
REMINDER_TIMEZONE=America/Mexico_City
# OBLIGATORIO en true: env.ts lo exige en produccion.
# Advertencia: server.ts arranca ambos workers dentro del proceso api cuando
# estan en true, y los procesos PM2 reminders/whatsapp-inbox tambien los
# arrancan. Revisar la duplicacion antes de usar los 4 procesos.
ENABLE_REMINDER_WORKER=true
ENABLE_WHATSAPP_INBOX_WORKER=true

# --- Proxy reverso (Hostinger) ---
# Hostinger usa un unico proxy inverso.
TRUST_PROXY=1

# --- Seed inicial del admin ---
# [RELLENAR MANUALMENTE] Solo lo usa `npm run db:seed`; no se valida al arrancar.
# Reglas de validacion: minimo 16 caracteres. Generar con: openssl rand -base64 24
# Eliminar o vaciar despues de crear el admin inicial.
ADMIN_SEED_PASSWORD=replace-with-admin-seed-password-min-16-chars

# --- Opcionales (no necesarias para arrancar) ---
# AI_PROVIDER_API_KEY=
# No usada por el MVP. Si se define, no puede ser placeholder.
