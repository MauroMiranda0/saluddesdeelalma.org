# backend/.env.example - Backend (Express 5)
#
# Plantilla de desarrollo. Copiar a `.env` (o usar `dotenv -e .env.example`).
# Los scripts de Prisma y los tests cargan este archivo.
#
# En producción usar `.env.production.example` y validar con:
#   npm run env:check:production --workspace backend

# --- Aplicación ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Base de datos ---
# En desarrollo puede ser un PostgreSQL local o un proyecto Supabase de pruebas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salud_desde_el_alma

# --- Autenticación admin ---
# En producción generar con: openssl rand -base64 48 (mínimo 32 caracteres)
JWT_SECRET=development-secret-with-at-least-32-characters
SESSION_COOKIE_NAME=sda_admin_session
SESSION_IDLE_TIMEOUT_MINUTES=30
COOKIE_DOMAIN=localhost
ADMIN_SEED_PASSWORD=development-admin-password

# --- Supabase Auth (requerido) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=development-anon-key

# --- WhatsApp Cloud API (Meta) ---
# Requeridas en producción; en desarrollo se usan valores ficticios para que
# los tests y los flujos de WhatsApp funcionen sin credenciales reales.
WHATSAPP_VERIFY_TOKEN=development-verify-token
WHATSAPP_ACCESS_TOKEN=development-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ADMIN_PHONE=5215500000000
WHATSAPP_PSYCHOLOGISTS_GROUP_ID=123456789012345

# --- Recordatorios ---
REMINDER_TIMEZONE=America/Mexico_City
ENABLE_REMINDER_WORKER=false
ENABLE_WHATSAPP_INBOX_WORKER=false

# --- Opcionales / avanzadas ---
# AI_PROVIDER_API_KEY=
# TRUST_PROXY=1
