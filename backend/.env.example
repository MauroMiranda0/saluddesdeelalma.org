NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://replace-with-user:replace-with-password@localhost:5432/saluddesdeelalma?schema=public"
JWT_SECRET="replace-with-a-strong-secret-of-at-least-32-characters"
ADMIN_SEED_PASSWORD=""
SESSION_COOKIE_NAME=sda_admin_session
SESSION_IDLE_TIMEOUT_MINUTES=30
WHATSAPP_VERIFY_TOKEN="replace-with-meta-webhook-verify-token"
WHATSAPP_ACCESS_TOKEN="replace-with-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-whatsapp-phone-number-id"
# Numero de WhatsApp individual de Jocelyn para avisos de comprobantes.
WHATSAPP_ADMIN_PHONE="replace-with-jocelyn-whatsapp-number"
# The provider-specific internal group destination. Verify provider group-send support before production.
WHATSAPP_PSYCHOLOGISTS_GROUP_ID="replace-with-psychologists-group-destination"
REMINDER_TIMEZONE=America/Mexico_City
# Arrancar el worker de recordatorios (cada 5 min) junto con el backend. Requerido en produccion; deshabilitado por defecto.
ENABLE_REMINDER_WORKER=false
# Arrancar el worker del inbox de WhatsApp (cada 30 s) junto con el backend. Requerido en produccion para que un webhook aceptado no quede sin procesar; deshabilitado por defecto.
ENABLE_WHATSAPP_INBOX_WORKER=false
# AI_PROVIDER_API_KEY sigue declarada y validada en produccion, pero ningun modulo la lee:
# la capa de IA que plan.md declara no existe. Su placeholder hace fallar el arranque en
# produccion si se deja sin reemplazar. Ver T209 en tasks.md.
AI_PROVIDER_API_KEY="replace-with-ai-provider-api-key"
# Confianza de proxy para que audit_logs registre la IP real del solicitante y no la del
# proxy. Sin esta variable Express ignora X-Forwarded-For, que es el comportamiento local.
# Definela solo en el entorno de despliegue, y segun cuantos proxies haya delante: un numero
# si hay uno solo, true si se confia en toda la cadena. Mantenerla comentada aqui es
# intencional: backend/tests/contract/security-hardening.contract.test.ts:176-190 fija que un
# X-Forwarded-For falsificado no compra presupuesto, y eso solo se cumple si no se declara.
# Ver la entrada del 30/09/2026 en docs/decisions.md.
# TRUST_PROXY=1
