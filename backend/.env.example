NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://replace-with-user:replace-with-password@localhost:5432/saluddesdeelalma?schema=public"
JWT_SECRET="replace-with-a-strong-secret-of-at-least-32-characters"
ADMIN_SEED_PASSWORD=""
SESSION_COOKIE_NAME=sda_admin_session
SESSION_IDLE_TIMEOUT_MINUTES=30
WHATSAPP_VERIFY_TOKEN="replace-with-meta-webhook-verify-token"
WHATSAPP_ACCESS_TOKEN="replace-with-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-whatsapp-phone-number-id"
# The provider-specific internal group destination. Verify provider group-send support before production.
WHATSAPP_PSYCHOLOGISTS_GROUP_ID="replace-with-psychologists-group-destination"
REMINDER_TIMEZONE=America/Mexico_City
AI_PROVIDER_API_KEY="replace-with-ai-provider-api-key"
