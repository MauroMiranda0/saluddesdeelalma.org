{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "dotenv -e .env.example -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:validate": "dotenv -e .env.example -- prisma validate --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "dotenv -e .env.example -- tsx --test tests/contract/*.test.ts tests/integration/*.test.ts tests/unit/*.test.ts && node --test tests/integration/users-access-constraints.integration.test.mjs",
    "test:integration": "npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reminders:worker": "tsx src/jobs/process-reminders.job.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "jose": "^6.2.11",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.12.0",
    "tsx": "^4.20.5"
  }
}
