# backend/.env.production.example
#
# Referencia para crear un archivo de runtime fuera del checkout.
# No copiar al repositorio ni al frontend; reemplazar los placeholders.
#
# En NODE_ENV=production el backend aborta el arranque si falta un valor
# obligatorio o si conserva un placeholder (ver backend/src/config/env.ts).
#
# El despliegue recibe su ubicación mediante BACKEND_ENV_FILE.

# --- Aplicación ---
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=https://saluddesdeelalma.org,https://www.saluddesdeelalma.org
LOG_LEVEL=info

# --- Base de datos (Supabase pooler, puerto 6543) ---
# Settings -> Database -> Connection string -> Transaction/Session pooler
# Debe usar el host *.pooler.supabase.com y el puerto 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:replace-with-database-password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Supabase Auth ---
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# --- Autenticación admin ---
# Generar con: openssl rand -base64 48 (mínimo 32 caracteres)
JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters
# Generar por separado con: openssl rand -base64 48
ADMIN_ACCESS_RECOVERY_TOKEN=replace-with-a-strong-recovery-token-of-at-least-32-characters
SESSION_COOKIE_NAME=sda_admin_session
SESSION_IDLE_TIMEOUT_MINUTES=30
COOKIE_DOMAIN=.saluddesdeelalma.org

# --- WhatsApp Cloud API (Meta) ---
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
# Phone Number ID numérico (solo dígitos, sin espacios ni símbolos)
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
# Número individual de Jocelyn en formato internacional, solo dígitos (ej. 521XXXXXXXXXX)
WHATSAPP_ADMIN_PHONE=replace-with-jocelyn-whatsapp-number
# Destino del grupo interno de psicólogas (verificar compatibilidad con Meta)
WHATSAPP_PSYCHOLOGISTS_GROUP_ID=replace-with-psychologists-group-destination

# --- Recordatorios ---
REMINDER_TIMEZONE=America/Mexico_City

# Los workers se ejecutan exclusivamente en procesos PM2 dedicados.

# --- Opcionales / avanzadas ---
# Si se define, NO puede ser un placeholder.
# AI_PROVIDER_API_KEY=replace-with-ai-provider-api-key
# Hostinger usa un único proxy inverso.
TRUST_PROXY=1
