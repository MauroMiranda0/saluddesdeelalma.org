{
  "name": "saluddesdeelalma-org",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run prisma:generate --workspace backend && npm run build --workspaces",
    "prebuild:shared-pilot": "node backend/scripts/check-shared-build.mjs",
    "build:shared-pilot": "npm run build",
    "env:check:production": "npm run env:check:production --workspace backend",
    "preflight:deploy": "node backend/scripts/validate-production-env.mjs --require-migration --require-frontend",
    "preflight:shared-pilot": "node backend/scripts/validate-production-env.mjs --process-env --require-frontend-relative --require-whatsapp-outbound-disabled",
    "start:shared-pilot": "node server.cjs",
    "clean:artifacts": "node -e \"for (const path of ['backend/dist','frontend/.next','frontend/tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "start:frontend": "npm run start --workspace frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "smoke:test": "node backend/scripts/smoke-test.mjs",
    "test:shared-pilot": "node --test backend/tests/unit/shared-server.test.cjs",
    "test:shared-integration": "node --test backend/tests/integration/shared-production-smoke.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown package.json backend frontend eslint.config.js prettier.config.js",
    "format:check": "prettier --check --ignore-unknown package.json backend frontend eslint.config.js prettier.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
