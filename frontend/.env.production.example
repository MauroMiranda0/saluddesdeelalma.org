# frontend/.env.production.example
#
# Referencia del valor público NEXT_PUBLIC_API_BASE_URL, inyectado al build
# ejecutado desde la raíz. No copiar `.env` al frontend.

# URL base del backend, incluyendo el prefijo /api/v1.
# Debe ser HTTPS y coincidir con API_PREFIX del backend.
NEXT_PUBLIC_API_BASE_URL=https://api.saluddesdeelalma.org/api/v1
