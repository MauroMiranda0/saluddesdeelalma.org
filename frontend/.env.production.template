# frontend/.env.production.template
#
# Plantilla final de produccion del frontend (Next.js).
# Copiar a frontend/.env.production antes de `next build`.
#
# Next.js inlinea las variables NEXT_PUBLIC_* en tiempo de BUILD:
#   - Cambiar el valor exige volver a compilar (`npm run build`).
#   - Nunca colocar secretos en variables NEXT_PUBLIC_*: quedan en el bundle.

# [RELLENAR MANUALMENTE]
# URL base del backend, incluyendo el prefijo /api/v1, sin barra final.
# Reglas de validacion:
#   - Debe ser HTTPS.
#   - Debe terminar en /api/v1 y coincidir con API_PREFIX del backend.
#   - El codigo lee NEXT_PUBLIC_API_BASE_URL (frontend/lib/api/client.ts);
#     NO usar NEXT_PUBLIC_API_URL, aunque aparezca en DEPLOY_PLAN.md.
NEXT_PUBLIC_API_BASE_URL=https://api.saluddesdeelalma.org/api/v1

# Verificar tras compilar:
#   npm run build --workspace frontend
#   grep -r "api.saluddesdeelalma.org/api/v1" frontend/.next
