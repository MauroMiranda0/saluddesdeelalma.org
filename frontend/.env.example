# frontend/.env.example - Frontend (Next.js 16)
#
# Plantilla de desarrollo. Copiar a `.env`.
# En producción usar `.env.production.example`.

# URL base del backend, incluyendo el prefijo /api/v1.
# Desarrollo: http://localhost:4000/api/v1
# Producción: https://api.saluddesdeelalma.org/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
